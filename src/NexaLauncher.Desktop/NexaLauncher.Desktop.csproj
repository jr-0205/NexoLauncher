<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NexaLauncher.Desktop</AssemblyName>
    <RootNamespace>NexaLauncher.Desktop</RootNamespace>
    <NexaUiDist>$(MSBuildProjectDirectory)\..\NexaLauncher.UI\dist</NexaUiDist>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <ProjectReference Include="..\NexoLauncher.Core\NexoLauncher.Core.csproj" />
    <ProjectReference Include="..\NexoLauncher.Domain\NexoLauncher.Domain.csproj" />
    <ProjectReference Include="..\NexoLauncher.Application\NexoLauncher.Application.csproj" />
    <ProjectReference Include="..\NexoLauncher.Infrastructure\NexoLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\NexoLauncher.Minecraft\NexoLauncher.Minecraft.csproj" />
    <ProjectReference Include="..\NexoLauncher.Java\NexoLauncher.Java.csproj" />
  </ItemGroup>

  <Target Name="CopyNexaUiToOutput" AfterTargets="Build" Condition="Exists('$(NexaUiDist)\index.html')">
    <ItemGroup>
      <_NexaUiFiles Include="$(NexaUiDist)\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)wwwroot" />
    <Copy
      SourceFiles="@(_NexaUiFiles)"
      DestinationFiles="@(_NexaUiFiles->'$(TargetDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNexaUiToPublish" AfterTargets="Publish" Condition="Exists('$(NexaUiDist)\index.html')">
    <ItemGroup>
      <_NexaUiPublishFiles Include="$(NexaUiDist)\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)wwwroot" />
    <Copy
      SourceFiles="@(_NexaUiPublishFiles)"
      DestinationFiles="@(_NexaUiPublishFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
