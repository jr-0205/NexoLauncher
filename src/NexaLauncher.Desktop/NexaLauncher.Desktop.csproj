<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NexaLauncher.Desktop</AssemblyName>
    <RootNamespace>NexaLauncher.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <ProjectReference Include="..\NexoLauncher.Core\NexoLauncher.Core.csproj" />
    <ProjectReference Include="..\NexoLauncher.Domain\NexoLauncher.Domain.csproj" />
    <ProjectReference Include="..\NexoLauncher.Application\NexoLauncher.Application.csproj" />
    <ProjectReference Include="..\NexoLauncher.Infrastructure\NexoLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\NexoLauncher.Minecraft\NexoLauncher.Minecraft.csproj" />
    <ProjectReference Include="..\NexoLauncher.Java\NexoLauncher.Java.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyNexaUiWhenBuilt" BeforeTargets="GetCopyToOutputDirectoryItems" Condition="Exists('..\NexaLauncher.UI\dist\index.html')">
    <ItemGroup>
      <Content Include="..\NexaLauncher.UI\dist\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
