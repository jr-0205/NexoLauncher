<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vector interpretation of the official NEXO mark supplied by the project owner. -->
    <LinearGradientBrush x:Key="Nexo.BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A5EFF" Offset="0"/>
        <GradientStop Color="#36A9FF" Offset="0.55"/>
        <GradientStop Color="#6FE0FF" Offset="1"/>
    </LinearGradientBrush>

    <DrawingImage x:Key="Nexo.BrandMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Nexo.BrandGradient}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 8,5 L 22,5 L 31,15 L 24,22 L 18,16 L 12,16 L 16,12 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Nexo.BrandGradient}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 25,5 L 40,5 L 34,11 L 41,18 L 31,18 L 23,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Nexo.BrandGradient}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 12,19 L 20,19 L 28,27 L 24,31 L 17,24 L 11,24 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Nexo.BrandGradient}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 30,21 L 42,21 L 36,27 L 42,33 L 31,33 L 25,27 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F4F7FC">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 7,17 L 14,17 L 11,20 L 5,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F4F7FC">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 23,17 L 30,17 L 27,20 L 20,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
