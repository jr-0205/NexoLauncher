<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:NexoLauncher.App">

    <app:ProfileIconConverter x:Key="Nexo.ProfileIconConverter"/>
    <app:ProfileBackgroundConverter x:Key="Nexo.ProfileBackgroundConverter"/>

    <DataTemplate x:Key="Nexo.ProfileCardTemplate">
        <Border Width="248" Height="184" CornerRadius="12"
                Background="{DynamicResource Nexo.Surface}" BorderBrush="{DynamicResource Nexo.Border}" BorderThickness="1">
            <Grid Margin="1">
                <Border CornerRadius="11">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#203F86"/>
                            <GradientStop Color="#172131" Offset="0.55"/>
                            <GradientStop Color="#090D13" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Use the rounded Border's brush renderer instead of a raw Image. WPF does not clip
                     child images to CornerRadius when only ClipToBounds is enabled. -->
                <Border CornerRadius="11" Opacity="0.78">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Id, Converter={StaticResource Nexo.ProfileBackgroundConverter}}"
                                    Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <Border CornerRadius="11">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#15090D13"/>
                            <GradientStop Color="#45090D13" Offset="0.48"/>
                            <GradientStop Color="#F2090D13" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="10" Background="#E6172131"
                                BorderBrush="{DynamicResource Nexo.BorderStrong}" BorderThickness="1"
                                HorizontalAlignment="Left">
                            <Grid Margin="1">
                                <Border CornerRadius="9" Background="#0B111B"/>
                                <Image Source="{DynamicResource Nexo.BrandMark}" Stretch="Uniform" Margin="7"/>
                                <Border CornerRadius="9">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Id, Converter={StaticResource Nexo.ProfileIconConverter}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="#D0172131" CornerRadius="7" Padding="8,5" VerticalAlignment="Top">
                            <TextBlock Text="NEXA" Foreground="#8DB3FF" FontSize="8" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Nexo.Text}" FontSize="15"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Nexo.TextSecondary}" FontSize="10"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Nexo.Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="  LISTO" Foreground="#80D9B9" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
