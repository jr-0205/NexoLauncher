<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NEXO UI Quality Module · semantic design tokens -->
    <Color x:Key="Nexo.Color.Background">#090D13</Color>
    <Color x:Key="Nexo.Color.Sidebar">#0D131D</Color>
    <Color x:Key="Nexo.Color.Surface">#121924</Color>
    <Color x:Key="Nexo.Color.SurfaceRaised">#172131</Color>
    <Color x:Key="Nexo.Color.SurfaceHover">#1B2940</Color>
    <Color x:Key="Nexo.Color.Border">#26364D</Color>
    <Color x:Key="Nexo.Color.BorderStrong">#38506F</Color>
    <Color x:Key="Nexo.Color.Text">#F4F7FC</Color>
    <Color x:Key="Nexo.Color.TextSecondary">#B4C0D2</Color>
    <Color x:Key="Nexo.Color.TextMuted">#7E8CA3</Color>
    <Color x:Key="Nexo.Color.Accent">#5B8CFF</Color>
    <Color x:Key="Nexo.Color.AccentHover">#72A0FF</Color>
    <Color x:Key="Nexo.Color.AccentPressed">#3E70E6</Color>
    <Color x:Key="Nexo.Color.Success">#4FC39B</Color>
    <Color x:Key="Nexo.Color.Warning">#E6B85C</Color>
    <Color x:Key="Nexo.Color.Danger">#F07878</Color>

    <SolidColorBrush x:Key="Nexo.Background" Color="{StaticResource Nexo.Color.Background}"/>
    <SolidColorBrush x:Key="Nexo.Sidebar" Color="{StaticResource Nexo.Color.Sidebar}"/>
    <SolidColorBrush x:Key="Nexo.Surface" Color="{StaticResource Nexo.Color.Surface}"/>
    <SolidColorBrush x:Key="Nexo.SurfaceRaised" Color="{StaticResource Nexo.Color.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Nexo.SurfaceHover" Color="{StaticResource Nexo.Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Nexo.Border" Color="{StaticResource Nexo.Color.Border}"/>
    <SolidColorBrush x:Key="Nexo.BorderStrong" Color="{StaticResource Nexo.Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Nexo.Text" Color="{StaticResource Nexo.Color.Text}"/>
    <SolidColorBrush x:Key="Nexo.TextSecondary" Color="{StaticResource Nexo.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Nexo.TextMuted" Color="{StaticResource Nexo.Color.TextMuted}"/>
    <SolidColorBrush x:Key="Nexo.Accent" Color="{StaticResource Nexo.Color.Accent}"/>
    <SolidColorBrush x:Key="Nexo.AccentHover" Color="{StaticResource Nexo.Color.AccentHover}"/>
    <SolidColorBrush x:Key="Nexo.AccentPressed" Color="{StaticResource Nexo.Color.AccentPressed}"/>
    <SolidColorBrush x:Key="Nexo.Success" Color="{StaticResource Nexo.Color.Success}"/>
    <SolidColorBrush x:Key="Nexo.Warning" Color="{StaticResource Nexo.Color.Warning}"/>
    <SolidColorBrush x:Key="Nexo.Danger" Color="{StaticResource Nexo.Color.Danger}"/>

    <Style x:Key="Nexo.FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource Nexo.Accent}"
                            BorderThickness="2"
                            CornerRadius="9"
                            Margin="-3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nexo.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Nexo.TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Nexo.Field" TargetType="TextBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Foreground" Value="{StaticResource Nexo.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Nexo.Text}"/>
        <Setter Property="Background" Value="#0E1622"/>
        <Setter Property="BorderBrush" Value="{StaticResource Nexo.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nexo.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Nexo.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Nexo.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nexo.PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Nexo.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nexo.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.90"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nexo.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Nexo.PrimaryButton}">
        <Setter Property="Background" Value="#20304A"/>
        <Setter Property="BorderBrush" Value="{StaticResource Nexo.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Nexo.GhostButton" TargetType="Button" BasedOn="{StaticResource Nexo.PrimaryButton}">
        <Setter Property="Background" Value="#141E2D"/>
        <Setter Property="BorderBrush" Value="{StaticResource Nexo.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Nexo.TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Nexo.NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Nexo.TextMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nexo.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Nexo.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Nexo.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nexo.ComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="#172130"/>
        <Setter Property="Background" Value="#F4F7FC"/>
        <Setter Property="BorderBrush" Value="{StaticResource Nexo.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nexo.FocusVisual}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#172130"/>
                    <Setter Property="Background" Value="#F4F7FC"/>
                    <Setter Property="Padding" Value="11,8"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#DDE8FF"/>
                            <Setter Property="Foreground" Value="#183E93"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#C8D9FF"/>
                            <Setter Property="Foreground" Value="#102F79"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nexo.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Nexo.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Nexo.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Nexo.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Nexo.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Nexo.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Nexo.TextSecondary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nexo.FocusVisual}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Nexo.Accent}"/>
        <Setter Property="Background" Value="#1A2638"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
