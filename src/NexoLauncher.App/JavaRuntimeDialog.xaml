<Window x:Class="NexoLauncher.App.JavaRuntimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Java · NEXO" Width="720" Height="540"
        MinWidth="620" MinHeight="480" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0C1015" Foreground="#F4F6FA" FontFamily="Segoe UI Variable Text" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#151B22"/>
        <SolidColorBrush x:Key="Stroke" Color="#303A45"/>
        <SolidColorBrush x:Key="Accent" Color="#4B7BFF"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#222C36"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="JAVA RUNTIME" Foreground="#6E97FF" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Seleccionar Java" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="NEXO detecta runtimes locales y evita iniciar Minecraft con una versión incompatible."
                       Foreground="#95A1B5" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#151B22" BorderBrush="#28323C" BorderThickness="1" CornerRadius="8" Padding="13,10" Margin="0,20,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="REQUISITO" Foreground="#65738A" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="RequirementText" Foreground="#DDE3EE" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" x:Name="RuntimeList" Background="Transparent" BorderThickness="0"
                 SelectionChanged="RuntimeList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Background="#151B22" BorderBrush="#303A45" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#536473"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#4B7BFF"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding VendorLine}" Foreground="#A4AFC1" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Path}" Foreground="#66758D" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#222C36" CornerRadius="7" Padding="10,6" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F19B8D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompatible}" Value="True"><Setter Property="Foreground" Value="#70D59B"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="BUSCAR MANUALMENTE" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="Manual_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="CANCELAR" Style="{StaticResource SecondaryButton}" Width="110" Click="Cancel_Click"/>
                <Button x:Name="UseButton" Content="USAR RUNTIME" Style="{StaticResource ActionButton}" Width="140" Margin="10,0,0,0" IsEnabled="False" Click="Use_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
