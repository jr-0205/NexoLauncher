<Window x:Class="NexoLauncher.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Nexo Launcher" Width="1180" Height="720" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="#090D14" Foreground="#F4F6FA" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#111824"/><SolidColorBrush x:Key="Stroke" Color="#29374C"/><SolidColorBrush x:Key="Muted" Color="#95A1B5"/><SolidColorBrush x:Key="Accent" Color="#766AF4"/>
  <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#A8B2C4"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="FieldStyle" TargetType="TextBox"><Setter Property="Height" Value="42"/><Setter Property="Foreground" Value="#EDF0F6"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Background" Value="#0D1420"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="46"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,9"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#253248"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#96A2B7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Nav" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#172235"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ComboStyle" TargetType="ComboBox"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="#111824"/><Setter Property="Background" Value="#F2F4F8"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#172130"/><Setter Property="Background" Value="#F2F4F8"/><Setter Property="Padding" Value="10,7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#DCE5FF"/><Setter Property="Foreground" Value="#2F2A86"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C9D7FF"/><Setter Property="Foreground" Value="#211A73"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0E1520" BorderBrush="#222E40" BorderThickness="0,0,1,0">
   <Grid Margin="26,30,24,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="NEXO" FontSize="29" FontWeight="Bold" Foreground="#9087FF"/><TextBlock Text="LAUNCHER" FontSize="10" FontWeight="SemiBold" Foreground="#7E899E" Margin="2,1,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,55,0,0">
     <Button x:Name="LibraryNavButton" Style="{StaticResource NavButton}" Click="ShowLibrary_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="17" Width="29"/><TextBlock Text="Mis instancias" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="InstallNavButton" Style="{StaticResource NavButton}" Click="ShowInstall_Click" Margin="0,5,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="18" Width="29"/><TextBlock Text="Nueva instalación" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2"><Border Height="1" Background="#233044" Margin="0,0,0,17"/><TextBlock Text="Nexo Launcher 0.2" Foreground="#6E7B91" FontSize="11"/><TextBlock Text="Vanilla · Sin telemetría" Foreground="#536078" FontSize="10" Margin="0,5,0,0"/></StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1">
   <Grid x:Name="LibraryPanel" Margin="36,30,36,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Mis instancias" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Tus instalaciones de Minecraft, listas para iniciar." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
     <Button Grid.Column="1" Content="＋  NUEVA INSTANCIA" Style="{StaticResource PrimaryButton}" Click="ShowInstall_Click"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,25,0">
      <ListBox x:Name="InstancesList" Background="Transparent" BorderThickness="0" SelectionChanged="InstancesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,16,18"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="2"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#776CF5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#3D4B64"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Grid Width="190"><Grid.RowDefinitions><RowDefinition Height="210"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Border CornerRadius="10" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4439A8"/><GradientStop Color="#17233A" Offset="0.55"/><GradientStop Color="#101722" Offset="1"/></LinearGradientBrush></Border.Background>
          <Grid><Ellipse Width="116" Height="116" Fill="#22FFFFFF"/><Border Width="82" Height="82" CornerRadius="18" Background="#202C40"><StackPanel VerticalAlignment="Center"><TextBlock Text="N" FontSize="38" FontWeight="Bold" Foreground="#9188FF" HorizontalAlignment="Center"/><TextBlock Text="VANILLA" FontSize="8" Foreground="#8995A9" HorizontalAlignment="Center"/></StackPanel></Border><Border VerticalAlignment="Bottom" Background="#80090D14" Padding="13,10"><TextBlock Text="INSTALADO" Foreground="#A9B3C4" FontSize="9" FontWeight="Bold"/></Border></Grid>
         </Border>
         <StackPanel Grid.Row="1" Margin="3,11,3,0"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#7F8BA0" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="EmptyLibrary" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="74" Height="74" Background="#172130" CornerRadius="18"><TextBlock Text="＋" FontSize="32" Foreground="#776CF5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Aún no hay instancias" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/><TextBlock Text="Descarga una versión para verla aquí." Foreground="#7D899E" Margin="0,7,0,0"/><Button Content="CREAR INSTANCIA" Style="{StaticResource SecondaryButton}" Click="ShowInstall_Click" Margin="0,20,0,0"/></StackPanel>
     </Grid>
     <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="#202C3E" BorderThickness="1" CornerRadius="12" Padding="24">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="DetailName" Text="Selecciona una instancia" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailSubtitle" Text="Los detalles aparecerán aquí." Foreground="#8290A6" Margin="0,7,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,25"><TextBlock Text="VERSIÓN" Foreground="#637188" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DetailVersion" Text="—" FontSize="14" Margin="0,7,0,18"/><TextBlock Text="LOADER" Foreground="#637188" FontSize="10" FontWeight="Bold"/><Border Background="#202B3D" CornerRadius="6" Padding="10,7" Margin="0,7,0,0"><TextBlock Text="Vanilla"/></Border></StackPanel>
       <Button Grid.Row="2" x:Name="LibraryPlayButton" Content="▶  INICIAR" Style="{StaticResource PrimaryButton}" Background="#167A42" IsEnabled="False" Click="LibraryPlay_Click"/>
      </Grid>
     </Border>
    </Grid>
   </Grid>

   <ScrollViewer x:Name="InstallPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <Grid Margin="46,34,46,34" MaxWidth="760" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Nueva instalación" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Elige una versión oficial y crea una instancia aislada." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
     <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="#202C3E" BorderThickness="1" CornerRadius="12" Padding="28" Margin="0,28,0,24"><StackPanel>
      <TextBlock Text="CONFIGURACIÓN" Foreground="#8F86FF" FontWeight="Bold" FontSize="11"/>
      <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Versión estable" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="VersionBox" Style="{StaticResource ComboStyle}" SelectionChanged="VersionBox_SelectionChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Nombre de jugador" Style="{StaticResource LabelStyle}"/><TextBox x:Name="UsernameBox" Style="{StaticResource FieldStyle}" Text="Player" MaxLength="16"/></StackPanel></Grid>
      <Grid Margin="0,23,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Java (javaw.exe)" Style="{StaticResource LabelStyle}"/><TextBox x:Name="JavaBox" Style="{StaticResource FieldStyle}" IsReadOnly="True"/></StackPanel><Button Grid.Column="2" Content="ELEGIR JAVA" Style="{StaticResource SecondaryButton}" Click="BrowseJava_Click" Height="42" VerticalAlignment="Bottom"/></Grid>
      <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Memoria asignada" Style="{StaticResource LabelStyle}"/><Slider x:Name="RamSlider" Minimum="1024" Maximum="8192" Value="4096" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="RamSlider_ValueChanged" Foreground="{StaticResource Accent}"/></StackPanel><Border Grid.Column="1" Background="#202B3D" CornerRadius="6" Padding="8,5" VerticalAlignment="Bottom"><TextBlock x:Name="RamText" Text="4 GB" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border></Grid>
      <StackPanel Margin="0,24,0,0"><TextBlock x:Name="StatusText" Text="Conectando con Mojang…" Foreground="#A8B2C4" FontSize="12" Margin="0,0,0,10"/><ProgressBar x:Name="Progress" Height="5" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="#263247" BorderThickness="0"/></StackPanel>
     </StackPanel></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock x:Name="InstallPathText" Foreground="#748198" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="PrimaryButton" Content="PREPARANDO…" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="PrimaryButton_Click"/></Grid>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
