<Window x:Class="NexoLauncher.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEXO Client" Width="1240" Height="760" MinWidth="1020" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="#080C12" Foreground="#F4F6FA"
 FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#101722"/>
  <SolidColorBrush x:Key="PanelAlt" Color="#0D141E"/>
  <SolidColorBrush x:Key="Stroke" Color="#263449"/>
  <SolidColorBrush x:Key="Muted" Color="#93A0B5"/>
  <SolidColorBrush x:Key="Accent" Color="#756AF4"/>
  <SolidColorBrush x:Key="Success" Color="#55C989"/>
  <SolidColorBrush x:Key="Danger" Color="#E27D73"/>

  <Style x:Key="LabelStyle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#A8B2C4"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style x:Key="FieldStyle" TargetType="TextBox">
   <Setter Property="Height" Value="42"/>
   <Setter Property="Foreground" Value="#EDF0F6"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="Background" Value="#0B111A"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Height" Value="44"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="18,9"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="Background" Value="#202D41"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="Background" Value="#151F2E"/>
   <Setter Property="Foreground" Value="#C8D0DE"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Foreground" Value="#8F9AAF"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="14,12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Nav" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#151F2E"/><Setter Property="Foreground" Value="White"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="ComboStyle" TargetType="ComboBox">
   <Setter Property="Height" Value="42"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Foreground" Value="#111824"/>
   <Setter Property="Background" Value="#F2F4F8"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="ItemContainerStyle">
    <Setter.Value>
     <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#172130"/>
      <Setter Property="Background" Value="#F2F4F8"/>
      <Setter Property="Padding" Value="10,7"/>
      <Style.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#DCE5FF"/><Setter Property="Foreground" Value="#2F2A86"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C9D7FF"/><Setter Property="Foreground" Value="#211A73"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      </Style.Triggers>
     </Style>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="CardStyle" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Panel}"/>
   <Setter Property="BorderBrush" Value="#202C3E"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="24"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Background="#0C121B" BorderBrush="#202C3E" BorderThickness="0,0,1,0">
   <Grid Margin="24,28,22,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <StackPanel>
     <TextBlock Text="NEXO" FontSize="29" FontWeight="Bold" Foreground="#928AFF"/>
     <TextBlock Text="CLIENT · MINECRAFT" FontSize="9" FontWeight="SemiBold" Foreground="#65738A" Margin="2,2,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,48,0,0">
     <TextBlock Text="LAUNCHER" Foreground="#56647A" FontSize="9" FontWeight="Bold" Margin="12,0,0,9"/>
     <Button x:Name="LibraryNavButton" Style="{StaticResource NavButton}" Click="ShowLibrary_Click">
      <StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="17" Width="29"/><TextBlock Text="Mis instancias" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="InstallNavButton" Style="{StaticResource NavButton}" Click="ShowInstall_Click" Margin="0,4,0,0">
      <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="18" Width="29"/><TextBlock Text="Nueva instalación" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="ShowSettings_Click" Margin="0,4,0,0">
      <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="29"/><TextBlock Text="Configuración" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     </Button>
    </StackPanel>

    <StackPanel Grid.Row="2">
     <Border Background="#101A28" CornerRadius="8" Padding="10,8" Margin="0,0,0,15">
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
       <TextBlock x:Name="SidebarStatusText" Text="NEXO CORE LISTO" Foreground="#8F9CB0" FontSize="9" FontWeight="SemiBold" Margin="8,0,0,0"/>
      </StackPanel>
     </Border>
     <Border Height="1" Background="#202D41" Margin="0,0,0,15"/>
     <TextBlock Text="NEXO Client 0.5.1" Foreground="#68758A" FontSize="11"/>
     <TextBlock Text="Nativo · Sin telemetría" Foreground="#4F5C70" FontSize="10" Margin="0,4,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1">
   <Grid x:Name="LibraryPanel" Margin="34,28,34,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Mis instancias" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="Perfiles aislados, configuración propia y arranque directo." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Content="＋  NUEVA INSTANCIA" Style="{StaticResource PrimaryButton}" Click="ShowInstall_Click"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,26,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="322"/></Grid.ColumnDefinitions>

     <Grid Margin="0,0,24,0">
      <ListBox x:Name="InstancesList" Background="Transparent" BorderThickness="0" SelectionChanged="InstancesList_SelectionChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
         <Setter Property="Margin" Value="0,0,15,18"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
         <Setter Property="Template">
          <Setter.Value>
           <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Selection" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="2"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#756AF4"/></Trigger>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#394963"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Setter.Value>
         </Setter>
        </Style>
       </ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Grid Width="188">
          <Grid.RowDefinitions><RowDefinition Height="198"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border CornerRadius="10" ClipToBounds="True">
           <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
             <GradientStop Color="#3E35A0"/><GradientStop Color="#17233A" Offset="0.56"/><GradientStop Color="#0E151F" Offset="1"/>
            </LinearGradientBrush>
           </Border.Background>
           <Grid>
            <Ellipse Width="112" Height="112" Fill="#18FFFFFF"/>
            <Border Width="80" Height="80" CornerRadius="18" Background="#202C40">
             <StackPanel VerticalAlignment="Center"><TextBlock Text="N" FontSize="37" FontWeight="Bold" Foreground="#9188FF" HorizontalAlignment="Center"/><TextBlock Text="NEXO" FontSize="8" Foreground="#8995A9" HorizontalAlignment="Center"/></StackPanel>
            </Border>
            <Border VerticalAlignment="Bottom" Background="#90080C12" Padding="12,9"><TextBlock Text="LISTO PARA JUGAR" Foreground="#AAB5C7" FontSize="8" FontWeight="Bold"/></Border>
           </Grid>
          </Border>
          <StackPanel Grid.Row="1" Margin="3,10,3,0">
           <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" Foreground="#78869C" FontSize="10" Margin="0,4,0,0"/>
          </StackPanel>
         </Grid>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel x:Name="EmptyLibrary" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Width="72" Height="72" Background="#151F2E" CornerRadius="18"><TextBlock Text="＋" FontSize="31" Foreground="#756AF4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <TextBlock Text="Aún no hay instancias" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,0"/>
       <TextBlock Text="Crea una instalación para comenzar." Foreground="#78869C" Margin="0,6,0,0"/>
       <Button Content="CREAR INSTANCIA" Style="{StaticResource SecondaryButton}" Click="ShowInstall_Click" Margin="0,18,0,0"/>
      </StackPanel>
     </Grid>

     <Border Grid.Column="1" Style="{StaticResource CardStyle}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel>
        <TextBlock Text="INSTANCIA" Foreground="#6259CF" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="DetailName" Text="Selecciona una instancia" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock x:Name="DetailSubtitle" Text="Los detalles aparecerán aquí." Foreground="#8290A6" Margin="0,6,0,0"/>
       </StackPanel>

       <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24,0,24">
        <TextBlock Text="VERSIÓN" Foreground="#5D6A7F" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="DetailVersion" Text="—" FontSize="13" Margin="0,6,0,15"/>
        <TextBlock Text="LOADER" Foreground="#5D6A7F" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="DetailLoader" Text="—" FontSize="13" Margin="0,6,0,15"/>
        <TextBlock Text="MEMORIA" Foreground="#5D6A7F" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="DetailMemory" Text="—" FontSize="13" Margin="0,6,0,15"/>
        <TextBlock Text="JAVA" Foreground="#5D6A7F" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="DetailJava" Text="—" FontSize="12" Foreground="#B8C1D0" Margin="0,6,0,0" TextWrapping="Wrap"/>
       </StackPanel>

       <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="86"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="DeleteInstanceButton" Content="BORRAR" Style="{StaticResource GhostButton}" Foreground="#FF8E8E" IsEnabled="False" Click="DeleteInstance_Click" Margin="0,0,8,0"/>
        <Button Grid.Column="1" x:Name="EditInstanceButton" Content="EDITAR" Style="{StaticResource GhostButton}" IsEnabled="False" Click="EditInstance_Click" Margin="0,0,9,0"/>
        <Button Grid.Column="2" x:Name="LibraryPlayButton" Content="▶  INICIAR" Style="{StaticResource PrimaryButton}" Background="#167A42" IsEnabled="False" Click="LibraryPlay_Click"/>
       </Grid>
      </Grid>
     </Border>
    </Grid>
   </Grid>

   <ScrollViewer x:Name="InstallPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <Grid Margin="44,32,44,34" MaxWidth="800" HorizontalAlignment="Center">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="Nueva instalación" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="Minecraft oficial con runtime validado y perfil aislado." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
     </StackPanel>

     <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,26,0,22">
      <StackPanel>
       <TextBlock Text="CONFIGURACIÓN DE JUEGO" Foreground="#8F86FF" FontWeight="Bold" FontSize="10"/>
       <Grid Margin="0,21,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Versión estable" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="VersionBox" Style="{StaticResource ComboStyle}" SelectionChanged="VersionBox_SelectionChanged"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Nombre de jugador" Style="{StaticResource LabelStyle}"/><TextBox x:Name="UsernameBox" Style="{StaticResource FieldStyle}" Text="Player" MaxLength="16"/></StackPanel>
       </Grid>

       <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Loader" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="LoaderBox" Style="{StaticResource ComboStyle}" SelectionChanged="LoaderBox_SelectionChanged"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Versión del loader" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="LoaderVersionBox" Style="{StaticResource ComboStyle}" SelectionChanged="LoaderVersionBox_SelectionChanged"/></StackPanel>
       </Grid>

       <StackPanel Margin="0,18,0,0">
        <TextBlock Text="Nombre de la instancia" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="InstanceNameBox" Style="{StaticResource FieldStyle}" MaxLength="64"/>
       </StackPanel>

       <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Java runtime" Style="{StaticResource LabelStyle}"/><TextBox x:Name="JavaBox" Style="{StaticResource FieldStyle}" IsReadOnly="True"/></StackPanel>
        <Button Grid.Column="2" Content="ELEGIR JAVA" Style="{StaticResource SecondaryButton}" Click="BrowseJava_Click" Height="42" VerticalAlignment="Bottom"/>
       </Grid>

       <Grid Margin="0,23,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Memoria asignada" Style="{StaticResource LabelStyle}"/>
         <Slider x:Name="RamSlider" Minimum="1024" Maximum="8192" Value="4096" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="RamSlider_ValueChanged" Foreground="{StaticResource Accent}"/>
         <TextBlock x:Name="InstallMemoryHintText" Text="NEXO ajusta el límite al hardware del equipo." Foreground="#627087" FontSize="10" Margin="0,7,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#1B2739" CornerRadius="6" Padding="8,5" VerticalAlignment="Top" Margin="0,20,0,0"><TextBlock x:Name="RamText" Text="4 GB" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border>
       </Grid>

       <Border Background="#0C131D" BorderBrush="#1D2A3C" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,22,0,0">
        <StackPanel>
         <TextBlock x:Name="StatusText" Text="Conectando con Mojang…" Foreground="#A8B2C4" FontSize="11"/>
         <ProgressBar x:Name="Progress" Height="4" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="#263247" BorderThickness="0" Margin="0,9,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </Border>

     <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="InstallPathText" Foreground="#65738A" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <Button Grid.Column="1" x:Name="PrimaryButton" Content="PREPARANDO…" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="PrimaryButton_Click"/>
     </Grid>
    </Grid>
   </ScrollViewer>

   <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <Grid Margin="44,32,44,40" MaxWidth="860" HorizontalAlignment="Center">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

     <StackPanel>
      <TextBlock Text="Configuración" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="Ajustes globales. Cada instancia puede sobrescribirlos sin duplicar configuración." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
     </StackPanel>

     <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,25,0,14">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="MEMORIA" Foreground="#8F86FF" FontWeight="Bold" FontSize="10"/>
        <TextBlock Text="Memoria global para Minecraft" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0"/>
        <TextBlock x:Name="SettingsMemorySummary" Text="Detectando memoria del sistema…" Foreground="#7F8CA0" FontSize="11" Margin="0,5,0,0"/>
        <Grid Margin="0,18,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
         <Slider x:Name="SettingsRamSlider" Minimum="1024" Maximum="8192" Value="4096" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="SettingsRamSlider_ValueChanged" Foreground="{StaticResource Accent}"/>
         <Border Grid.Column="1" Background="#1B2739" CornerRadius="6" Padding="8,5" Margin="12,0,0,0"><TextBlock x:Name="SettingsRamText" Text="4 GB" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border>
        </Grid>
       </StackPanel>
       <Button Grid.Column="1" Content="USAR RECOMENDADO" Style="{StaticResource GhostButton}" Click="UseRecommendedMemory_Click" Width="190" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
      </Grid>
     </Border>

     <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="JAVA RUNTIME" Foreground="#8F86FF" FontWeight="Bold" FontSize="10"/>
        <TextBlock x:Name="SettingsJavaText" Text="Detectando Java…" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0"/>
        <TextBlock x:Name="SettingsJavaPathText" Text="—" Foreground="#6F7D92" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SettingsRuntimeCountText" Text="0 runtimes detectados" Foreground="#8B98AC" FontSize="11" Margin="0,10,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Button Content="ELEGIR RUNTIME" Style="{StaticResource SecondaryButton}" Click="SettingsBrowseJava_Click"/>
        <Button x:Name="RedetectJavaButton" Content="DETECTAR DE NUEVO" Style="{StaticResource GhostButton}" Click="RedetectJava_Click" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
     </Border>

     <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="PERFIL LOCAL" Foreground="#8F86FF" FontWeight="Bold" FontSize="10"/>
        <TextBlock Text="Nombre predeterminado" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0"/>
        <TextBlock Text="Se usa mientras no haya una sesión Microsoft conectada." Foreground="#78869B" FontSize="11" Margin="0,5,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Nombre de jugador" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="SettingsUsernameBox" Style="{StaticResource FieldStyle}" MaxLength="16"/>
       </StackPanel>
      </Grid>
     </Border>

     <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="COMPORTAMIENTO" Foreground="#8F86FF" FontWeight="Bold" FontSize="10"/>
        <TextBlock Text="Al iniciar Minecraft" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0"/>
        <TextBlock Text="Cerrar el launcher reduce uso de RAM y procesos cuando el juego ya está activo." Foreground="#78869B" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
       </StackPanel>
       <CheckBox Grid.Column="1" x:Name="SettingsCloseLauncherCheck" Content="Cerrar NEXO al iniciar el juego" Foreground="#DCE2EC" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
     </Border>

     <Grid Grid.Row="5">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SettingsStatusText" Text="Los cambios se guardan localmente." Foreground="#647288" FontSize="10" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="GUARDAR CAMBIOS" Style="{StaticResource PrimaryButton}" Click="SettingsSave_Click"/>
     </Grid>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
