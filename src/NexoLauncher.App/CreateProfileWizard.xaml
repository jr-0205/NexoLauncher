<Window x:Class="NexoLauncher.App.CreateProfileWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear perfil · NEXO"
        Width="1180" Height="760" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{DynamicResource Nexo.Background}" Foreground="{DynamicResource Nexo.Text}"
        FontFamily="Segoe UI Variable Text" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="WizardRailButton" TargetType="Button">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Nexo.TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Nexo.Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Nexo.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoaderChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Nexo.TextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource Nexo.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Nexo.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Nexo.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1C3158"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Nexo.Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{DynamicResource Nexo.Surface}" BorderBrush="{DynamicResource Nexo.Border}"
                                BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Nexo.SurfaceHover}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Nexo.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#182B4F"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Nexo.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Product rail -->
        <Grid Background="#070B11" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="26,26,22,0">
                <Image Source="{DynamicResource Nexo.BrandMark}" Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Left"/>
                <TextBlock Text="NEXO" FontSize="22" FontWeight="Bold" Margin="0,9,0,0"/>
                <TextBlock Text="CREAR PERFIL" Foreground="{DynamicResource Nexo.Accent}" FontSize="9" FontWeight="Bold" Margin="1,2,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="20,38,18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="2" Background="{DynamicResource Nexo.Border}" HorizontalAlignment="Center" Margin="0,34,0,108"/>
                <StackPanel Grid.ColumnSpan="2">
                    <Button x:Name="InfoStepButton" Style="{StaticResource WizardRailButton}" Click="GoInfo_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="InfoStepDot" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Nexo.Accent}" HorizontalAlignment="Center">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Información" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Nombre y descripción" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="VersionStepButton" Style="{StaticResource WizardRailButton}" Click="GoVersion_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="VersionStepDot" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Nexo.SurfaceHover}" HorizontalAlignment="Center">
                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Versión del juego" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Minecraft y loader" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="AppearanceStepButton" Style="{StaticResource WizardRailButton}" Click="GoAppearance_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="AppearanceStepDot" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Nexo.SurfaceHover}" HorizontalAlignment="Center">
                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Apariencia" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Icono y fondo" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Button Grid.Row="2" Content="RESTABLECER" Style="{DynamicResource Nexo.GhostButton}" Margin="26,0,26,24" Height="40" Click="Reset_Click"/>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource Nexo.Border}"/>

        <!-- Main wizard canvas -->
        <Grid Grid.Column="2" Margin="34,28,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Step 1 -->
            <Grid x:Name="InfoPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,18,0">
                        <TextBlock Text="Información del perfil" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Crea un perfil independiente. NEXO mantendrá separados mundos, mods, configuración y ajustes aunque otro perfil use la misma versión." Foreground="{DynamicResource Nexo.TextSecondary}" Margin="0,7,0,28" TextWrapping="Wrap"/>

                        <TextBlock Text="NOMBRE" Style="{DynamicResource Nexo.Label}"/>
                        <TextBox x:Name="ProfileNameBox" Style="{DynamicResource Nexo.Field}" MaxLength="64" TextChanged="ProfileNameBox_TextChanged"/>
                        <TextBlock x:Name="NameCounterText" Text="64 caracteres restantes" HorizontalAlignment="Right" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,5,0,22"/>

                        <TextBlock Text="DESCRIPCIÓN" Style="{DynamicResource Nexo.Label}"/>
                        <Border Background="#0E1622" BorderBrush="{DynamicResource Nexo.Border}" BorderThickness="1" CornerRadius="9" Height="138">
                            <TextBox x:Name="DescriptionBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Nexo.Text}" CaretBrush="{DynamicResource Nexo.Text}"
                                     Padding="12,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="300" TextChanged="DescriptionBox_TextChanged"/>
                        </Border>
                        <TextBlock x:Name="DescriptionCounterText" Text="300 caracteres restantes" HorizontalAlignment="Right" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,5,0,22"/>

                        <Border Background="#101A29" BorderBrush="{DynamicResource Nexo.Border}" BorderThickness="1" CornerRadius="11" Padding="16">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="9" Background="#1A315C">
                                    <TextBlock Text="✓" Foreground="#79E1BC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Perfil aislado por diseño" FontWeight="SemiBold"/>
                                    <TextBlock Text="Cada perfil obtiene un GUID propio y un game directory independiente. Esta protección no se puede desactivar." Foreground="{DynamicResource Nexo.TextMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Step 2 -->
            <Grid x:Name="VersionPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Seleccionar versión del juego" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Elige Minecraft y el loader. Java y la build estable del loader se resolverán automáticamente." Foreground="{DynamicResource Nexo.TextSecondary}" Margin="0,7,0,22"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="VanillaLoader" Content="Vanilla" Style="{StaticResource LoaderChip}" Checked="Loader_Checked" IsChecked="True"/>
                        <RadioButton x:Name="FabricLoader" Content="Fabric" Style="{StaticResource LoaderChip}" Checked="Loader_Checked"/>
                        <RadioButton x:Name="ForgeLoader" Content="Forge" Style="{StaticResource LoaderChip}" Checked="Loader_Checked"/>
                        <RadioButton x:Name="NeoForgeLoader" Content="NeoForge" Style="{StaticResource LoaderChip}" Checked="Loader_Checked"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" x:Name="VersionSearchBox" Style="{DynamicResource Nexo.Field}" ToolTip="Buscar versión, por ejemplo 1.21.1" TextChanged="VersionSearchBox_TextChanged"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="VersionList" ItemContainerStyle="{StaticResource VersionItem}" Background="Transparent" BorderThickness="0"
                             SelectionChanged="VersionList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ReleaseTime, StringFormat='Publicada {0:yyyy-MM-dd}'}" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#153829" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="RELEASE" Foreground="#72DDB7" FontSize="8" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="1" Background="{DynamicResource Nexo.Surface}" BorderBrush="{DynamicResource Nexo.Border}" BorderThickness="1" CornerRadius="12" Margin="18,0,0,0" Padding="19">
                        <StackPanel>
                            <TextBlock Text="CONFIGURACIÓN" Foreground="{DynamicResource Nexo.Accent}" FontWeight="Bold" FontSize="9"/>
                            <TextBlock x:Name="SelectedVersionText" Text="Selecciona una versión" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedLoaderText" Text="Vanilla" Foreground="{DynamicResource Nexo.TextSecondary}" Margin="0,4,0,18"/>

                            <StackPanel x:Name="LoaderVersionSection" Visibility="Collapsed">
                                <TextBlock Text="VERSIÓN DEL LOADER" Style="{DynamicResource Nexo.Label}"/>
                                <ComboBox x:Name="LoaderVersionBox" Style="{DynamicResource Nexo.ComboBox}" SelectionChanged="LoaderVersionBox_SelectionChanged"/>
                                <TextBlock x:Name="LoaderStatusText" Text="" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,7,0,18" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Background="#0D1520" BorderBrush="{DynamicResource Nexo.Border}" BorderThickness="1" CornerRadius="9" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="JAVA" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="Automático" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="NEXO elegirá el runtime correcto para esta versión." Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Step 3 -->
            <Grid x:Name="AppearancePanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="850" HorizontalAlignment="Left" Margin="0,0,18,0">
                        <TextBlock Text="Personalizar perfil" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Haz que cada perfil sea reconocible de un vistazo. El icono y el fondo se copian dentro del perfil y permanecen aunque muevas el archivo original." Foreground="{DynamicResource Nexo.TextSecondary}" Margin="0,7,0,25" TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ICONO" Style="{DynamicResource Nexo.Label}"/>
                                <Border Height="190" Background="#0D1520" BorderBrush="{DynamicResource Nexo.Border}" BorderThickness="1" CornerRadius="12" Padding="18" ClipToBounds="True">
                                    <Image x:Name="IconPreview" Source="{DynamicResource Nexo.BrandMark}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <Button Content="ELEGIR ICONO" Style="{DynamicResource Nexo.SecondaryButton}" Margin="0,10,0,0" Height="40" Click="ChooseIcon_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FONDO" Style="{DynamicResource Nexo.Label}"/>
                                <Border Height="190" Background="#0D1520" BorderBrush="{DynamicResource Nexo.Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                    <Grid>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#16294C"/>
                                                    <GradientStop Color="#101927" Offset="0.55"/>
                                                    <GradientStop Color="#080C12" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Image x:Name="BackgroundPreview" Stretch="UniformToFill"/>
                                        <Border Background="#28090D13"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{DynamicResource Nexo.BrandMark}" Width="58" Height="58" Stretch="Uniform" Opacity="0.55" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <TextBlock Text="FONDO DEL PERFIL" Foreground="{DynamicResource Nexo.TextMuted}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button Content="ELEGIR FONDO" Style="{DynamicResource Nexo.SecondaryButton}" Margin="0,10,0,0" Height="40" Click="ChooseBackground_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="PNG, JPG, JPEG o BMP. Recomendado: icono cuadrado y fondo panorámico." Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,14,0,20"/>

                        <Expander Header="Opciones avanzadas">
                            <Border Background="{DynamicResource Nexo.Surface}" BorderBrush="{DynamicResource Nexo.Border}" BorderThickness="1" CornerRadius="11" Margin="0,10,0,0" Padding="16">
                                <StackPanel>
                                    <CheckBox x:Name="CustomMemoryCheck" Content="Usar memoria personalizada sólo en este perfil" Checked="CustomMemoryCheck_Changed" Unchecked="CustomMemoryCheck_Changed"/>
                                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="MemorySlider" Minimum="1024" Maximum="8192" TickFrequency="512" IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="MemorySlider_ValueChanged"/>
                                        <Border Grid.Column="1" Background="{DynamicResource Nexo.SurfaceHover}" CornerRadius="7" Margin="12,0,0,0">
                                            <TextBlock x:Name="MemoryText" Text="4 GB" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="MemoryHintText" Text="Por defecto NEXO usa la memoria global recomendada." Foreground="{DynamicResource Nexo.TextMuted}" FontSize="10" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHintText" Text="Paso 1 de 3 · Escribe un nombre para continuar." Foreground="{DynamicResource Nexo.TextMuted}" VerticalAlignment="Center" FontSize="10"/>
                <Button Grid.Column="1" x:Name="BackButton" Content="ATRÁS" Style="{DynamicResource Nexo.GhostButton}" Width="116" Margin="0,0,10,0" Click="Back_Click" IsEnabled="False"/>
                <Button Grid.Column="2" x:Name="NextButton" Content="SIGUIENTE" Style="{DynamicResource Nexo.PrimaryButton}" Width="174" Click="Next_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
