<Window x:Class="NexoLauncher.App.InstanceEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Editar instancia · NEXO" Width="590" Height="720" MinHeight="650" ResizeMode="CanResizeWithGrip"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#0C1015" Foreground="#EEF3FA"
 FontFamily="Segoe UI Variable Text" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Blue" Color="#4B7BFF"/>
  <SolidColorBrush x:Key="Surface" Color="#151B22"/>
  <SolidColorBrush x:Key="Stroke" Color="#303A45"/>
  <Style TargetType="TextBox">
   <Setter Property="Height" Value="42"/><Setter Property="Foreground" Value="#EDF3FA"/><Setter Property="CaretBrush" Value="#8DB3FF"/>
   <Setter Property="Background" Value="#10161C"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Blue}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="17,8"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Background" Value="#222C36"/><Setter Property="Foreground" Value="#DCE6F2"/></Style>
    <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#CDD7E3"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal">
     <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#10161C" BorderBrush="#3A4652" BorderThickness="1">
      <TextBlock x:Name="Mark" Text="✓" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#4B7BFF"/><Setter TargetName="Box" Property="BorderBrush" Value="#4B7BFF"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Box" Property="Background" Value="#273653"/><Setter TargetName="Mark" Property="Text" Value="−"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A9B6C5"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
 </Window.Resources>
 <Grid Margin="30,26,30,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="AJUSTES DEL PERFIL" Foreground="#6E97FF" FontSize="10" FontWeight="Bold"/>
   <TextBlock Text="Editar instancia" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/>
   <TextBlock x:Name="IdentityText" Foreground="#8796A7" Margin="0,6,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="#28323C" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,22,0,20">
   <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Text="Nombre" Style="{StaticResource Label}"/><TextBox x:Name="NameBox" MaxLength="64"/>
     <TextBlock Text="RAM en MiB" Style="{StaticResource Label}" Margin="0,17,0,7"/><TextBox x:Name="MemoryBox" ToolTip="Vacío usa la memoria global"/>
     <TextBlock Text="Java de la instancia" Style="{StaticResource Label}" Margin="0,17,0,7"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBox x:Name="JavaBox" ToolTip="Vacío mantiene selección automática"/><Button Grid.Column="1" Content="BUSCAR" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseJava_Click"/></Grid>
     <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Ancho de ventana" Style="{StaticResource Label}"/><TextBox x:Name="WidthBox"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Alto de ventana" Style="{StaticResource Label}"/><TextBox x:Name="HeightBox"/></StackPanel>
     </Grid>
     <CheckBox x:Name="FullscreenBox" Content="Pantalla completa" IsThreeState="True" Margin="0,18,0,0" ToolTip="Indeterminado hereda el valor global"/>
     <TextBlock Text="Argumentos JVM" Style="{StaticResource Label}" Margin="0,18,0,7"/>
     <TextBox x:Name="JvmArgumentsBox" Height="92" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Hidden" ToolTip="Un argumento por línea"/>
     <TextBlock x:Name="ValidationText" Foreground="#F07167" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
   <Button Grid.Column="1" Content="CANCELAR" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" IsCancel="True"/>
   <Button Grid.Column="2" Content="GUARDAR" Style="{StaticResource ActionButton}" IsDefault="True" Click="Save_Click"/>
  </Grid>
 </Grid>
</Window>