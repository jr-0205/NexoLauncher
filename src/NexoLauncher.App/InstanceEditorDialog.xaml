<Window x:Class="NexoLauncher.App.InstanceEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Editar perfil · NEXO" Width="720" Height="820" MinWidth="650" MinHeight="680" ResizeMode="CanResizeWithGrip"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#090D13" Foreground="#F4F7FC"
 FontFamily="Segoe UI Variable Text" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Blue" Color="#5B8CFF"/>
  <SolidColorBrush x:Key="Surface" Color="#121924"/>
  <SolidColorBrush x:Key="Stroke" Color="#26364D"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource Nexo.Field}"/>
  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Nexo.PrimaryButton}"/>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource Nexo.SecondaryButton}"/>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource Nexo.GhostButton}"/>
  <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Nexo.Label}"/>
 </Window.Resources>
 <Grid Margin="30,26,30,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="AJUSTES DEL PERFIL" Foreground="#5B8CFF" FontSize="10" FontWeight="Bold"/>
   <TextBlock Text="Editar perfil" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/>
   <TextBlock x:Name="IdentityText" Foreground="#7E8CA3" Margin="0,6,0,0"/>
  </StackPanel>

  <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,22,0,20">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
     <TextBlock Text="INFORMACIÓN" Foreground="#5B8CFF" FontWeight="Bold" FontSize="9"/>
     <TextBlock Text="Nombre" Style="{StaticResource Label}" Margin="0,14,0,7"/>
     <TextBox x:Name="NameBox" MaxLength="64"/>
     <TextBlock Text="Descripción" Style="{StaticResource Label}" Margin="0,15,0,7"/>
     <TextBox x:Name="DescriptionBox" Height="72" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

     <Separator Margin="0,22,0,20"/>
     <TextBlock Text="APARIENCIA" Foreground="#5B8CFF" FontWeight="Bold" FontSize="9"/>
     <TextBlock Text="Cambia el icono y el fondo del perfil sin alterar su carpeta, versión ni contenido." Foreground="#7E8CA3" FontSize="11" Margin="0,6,0,15" TextWrapping="Wrap"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Icono" Style="{StaticResource Label}"/>
       <Border Height="150" Background="#0E1622" BorderBrush="#26364D" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Image x:Name="IconPreview" Stretch="Uniform" Margin="15"/>
       </Border>
       <Button Content="CAMBIAR ICONO" Style="{StaticResource SecondaryButton}" Margin="0,9,0,0" Click="ChooseIcon_Click"/>
       <Button Content="RESTABLECER" Style="{StaticResource GhostButton}" Height="34" Margin="0,7,0,0" Click="ResetIcon_Click"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="Fondo" Style="{StaticResource Label}"/>
       <Border Height="150" Background="#0E1622" BorderBrush="#26364D" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
         <Image x:Name="BackgroundPreview" Stretch="UniformToFill"/>
         <Border Background="#55090D13" VerticalAlignment="Bottom" Padding="10,7">
          <TextBlock Text="VISTA PREVIA DEL PERFIL" FontSize="9" FontWeight="Bold" Foreground="#B4C0D2"/>
         </Border>
        </Grid>
       </Border>
       <Button Content="CAMBIAR FONDO" Style="{StaticResource SecondaryButton}" Margin="0,9,0,0" Click="ChooseBackground_Click"/>
       <Button Content="QUITAR FONDO" Style="{StaticResource GhostButton}" Height="34" Margin="0,7,0,0" Click="ClearBackground_Click"/>
      </StackPanel>
     </Grid>

     <Separator Margin="0,22,0,20"/>
     <TextBlock Text="RENDIMIENTO Y EJECUCIÓN" Foreground="#5B8CFF" FontWeight="Bold" FontSize="9"/>
     <TextBlock Text="RAM en MiB" Style="{StaticResource Label}" Margin="0,14,0,7"/><TextBox x:Name="MemoryBox" ToolTip="Vacío usa la memoria global"/>
     <TextBlock Text="Java del perfil" Style="{StaticResource Label}" Margin="0,17,0,7"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBox x:Name="JavaBox" ToolTip="Vacío mantiene selección automática"/><Button Grid.Column="1" Content="BUSCAR" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseJava_Click"/></Grid>
     <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Ancho de ventana" Style="{StaticResource Label}"/><TextBox x:Name="WidthBox"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Alto de ventana" Style="{StaticResource Label}"/><TextBox x:Name="HeightBox"/></StackPanel>
     </Grid>
     <CheckBox x:Name="FullscreenBox" Content="Pantalla completa" IsThreeState="True" Margin="0,18,0,0" ToolTip="Indeterminado hereda el valor global"/>
     <TextBlock Text="Argumentos JVM" Style="{StaticResource Label}" Margin="0,18,0,7"/>
     <TextBox x:Name="JvmArgumentsBox" Height="92" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="Un argumento por línea"/>
     <TextBlock x:Name="ValidationText" Foreground="#F07878" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Border>

  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
   <Button Grid.Column="1" Content="CANCELAR" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" IsCancel="True"/>
   <Button Grid.Column="2" Content="GUARDAR" Style="{StaticResource ActionButton}" IsDefault="True" Click="Save_Click"/>
  </Grid>
 </Grid>
</Window>